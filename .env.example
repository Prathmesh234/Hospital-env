# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=hospital
POSTGRES_USER=hospital
POSTGRES_PASSWORD=hospital_dev_password
# Full URL takes precedence if set
POSTGRES_URL=postgresql+psycopg://hospital:hospital_dev_password@localhost:5432/hospital

# --- MongoDB ---
MONGO_HOST=localhost
MONGO_PORT=27017
MONGO_DB=hospital_docs
MONGO_USER=hospital
MONGO_PASSWORD=hospital_dev_password
MONGO_URL=mongodb://hospital:hospital_dev_password@localhost:27017/hospital_docs?authSource=admin

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
LOG_LEVEL=INFO
